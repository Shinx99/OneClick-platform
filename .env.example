# PostgreSQL Database Configs
POSTGRES_DB_AUTH=auth_db
POSTGRES_USER_AUTH=auth_user
POSTGRES_PASSWORD_AUTH=auth_password

POSTGRES_DB_RECRUITMENT=recruitment_db
POSTGRES_USER_RECRUITMENT=recruitment_user
POSTGRES_PASSWORD_RECRUITMENT=recruitment_password

# Redis Configs
REDIS_HOST=redis-auth
REDIS_PORT=6379

# MinIO Configs
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=adminpassword

# JWT & Internal Secrets
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_secure
INTERNAL_SECRET=internal_communication_secret

# Other API Keys
CLOUDINARY_URL=cloudinary://your_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# CORS
ALLOWED_ORIGINS=http://localhost:3000
